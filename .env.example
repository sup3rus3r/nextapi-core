# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Frontend / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-nextauth-secret-here
# Must match ENCRYPTION_KEY above
NEXT_PUBLIC_ENCRYPTION_KEY=your-encryption-key-here

# Mobile (Capacitor) only -static export has no server to proxy through,
# so it calls FastAPI directly. Use a LAN IP / tunnel, not localhost, on device.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Which app shell wraps every authenticated page: "sidebar" (default) or
# "navbar". Build-time choice, not a runtime toggle.
NEXT_PUBLIC_APP_SHELL=sidebar

# The module registry the CLI (npm run nextapi -- add/sync/publish/...)
# installs from and publishes to is hardcoded in
# scripts/nextapi-cli/lib/registryClient.mjs - nextapi-core always installs
# from the one official registry, so there is nothing to configure here.

# Optional overrides (defaults shown)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_USER=60
RATE_LIMIT_API_CLIENT=100

# Database: "sqlite" (default) or "mongo"
DATABASE_TYPE=sqlite

# Only needed when DATABASE_TYPE=mongo
MONGO_URI=mongodb://user:pass@host:27017/dbname
